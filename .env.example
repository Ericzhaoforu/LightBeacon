# Copy to .env and replace every CHANGE_ME value before starting the host.
LIGHTBEACON_BIND_HOST=0.0.0.0
LIGHTBEACON_HTTP_PORT=8080
LIGHTBEACON_UDP_PORT=40404
LIGHTBEACON_DATA_DIR=./data
LIGHTBEACON_LOG_DIR=./logs

# 32 random bytes encoded as 64 hexadecimal characters.
LIGHTBEACON_HMAC_KEY=CHANGE_ME_64_HEX_CHARACTERS
LIGHTBEACON_SESSION_SECRET=CHANGE_ME_64_HEX_CHARACTERS

# Generate with: python -m lightbeacon.cli hash-password
LIGHTBEACON_ADMIN_PASSWORD_HASH=CHANGE_ME_SCRYPT_HASH

# Address reachable by ESP32 nodes during OTA, for example http://192.168.50.2:8080
LIGHTBEACON_PUBLIC_BASE_URL=http://127.0.0.1:8080

# Development-only SoftAP password. Override for every deployed build.
LIGHTBEACON_PROVISIONING_PASSWORD=CHANGE_ME_8_OR_MORE_CHARACTERS

